      <Collection Name="Columns" Type="Column">
        <SubRecord><Property Name="Name">event_timestamp</Property><Property Name="SqlType">12</Property><Property Name="Precision">26</Property><Property Name="Scale">0</Property><Property Name="Nullable">0</Property></SubRecord>
        <SubRecord><Property Name="Name">team</Property><Property Name="SqlType">12</Property><Property Name="Precision">64</Property><Property Name="Scale">0</Property><Property Name="Nullable">0</Property></SubRecord>
        <SubRecord><Property Name="Name">product</Property><Property Name="SqlType">12</Property><Property Name="Precision">64</Property><Property Name="Scale">0</Property><Property Name="Nullable">0</Property></SubRecord>
        <SubRecord><Property Name="Name">provider</Property><Property Name="SqlType">12</Property><Property Name="Precision">64</Property><Property Name="Scale">0</Property><Property Name="Nullable">0</Property></SubRecord>
        <SubRecord><Property Name="Name">model</Property><Property Name="SqlType">12</Property><Property Name="Precision">64</Property><Property Name="Scale">0</Property><Property Name="Nullable">0</Property></SubRecord>
        <SubRecord><Property Name="Name">environment</Property><Property Name="SqlType">12</Property><Property Name="Precision">32</Property><Property Name="Scale">0</Property><Property Name="Nullable">0</Property></SubRecord>
        <SubRecord><Property Name="Name">region</Property><Property Name="SqlType">12</Property><Property Name="Precision">32</Property><Property Name="Scale">0</Property><Property Name="Nullable">0</Property></SubRecord>
        <SubRecord><Property Name="Name">requests</Property><Property Name="SqlType">-5</Property><Property Name="Precision">19</Property><Property Name="Scale">0</Property><Property Name="Nullable">0</Property></SubRecord>
        <SubRecord><Property Name="Name">input_tokens</Property><Property Name="SqlType">-5</Property><Property Name="Precision">19</Property><Property Name="Scale">0</Property><Property Name="Nullable">0</Property></SubRecord>
        <SubRecord><Property Name="Name">output_tokens</Property><Property Name="SqlType">-5</Property><Property Name="Precision">19</Property><Property Name="Scale">0</Property><Property Name="Nullable">0</Property></SubRecord>
