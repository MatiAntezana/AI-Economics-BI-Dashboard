    <!-- Stage 6: Transformer - Stage Variables & Economic Calculations -->
    <Record Identifier="V0S6" Type="TransformerStage" Readonly="0">
      <Property Name="Name">xfm_economics_metrics</Property>
      <Property Name="StageType">PxTransformer</Property>
      <Property Name="NextID">3</Property>
      <Property Name="InputPins">V0S6P1</Property>
      <Property Name="OutputPins">V0S6P2</Property>
      <Collection Name="StageVars" Type="StageVar">
        <SubRecord>
          <Property Name="Name">svEventDate</Property>
          <Property Name="Expression">StringToDate(Left(lnk_enriched_telemetry.event_timestamp, 10), "%yyyy-%mm-%dd")</Property>
          <Property Name="SqlType">9</Property>
        </SubRecord>
        <SubRecord>
          <Property Name="Name">svEnvShare</Property>
          <Property Name="Expression">If lnk_enriched_telemetry.environment = "production" Then 0.86 Else If lnk_enriched_telemetry.environment = "staging" Then 0.10 Else 0.04</Property>
          <Property Name="SqlType">8</Property>
        </SubRecord>
        <SubRecord>
          <Property Name="Name">svRawErrorRate</Property>
          <Property Name="Expression">AsDouble(lnk_enriched_telemetry.error_count) / AsDouble(lnk_enriched_telemetry.requests)</Property>
          <Property Name="SqlType">8</Property>
        </SubRecord>
        <SubRecord>
          <Property Name="Name">svErrorRate</Property>
          <Property Name="Expression">If svRawErrorRate &gt; 0.20 Then 0.20 Else If svRawErrorRate &lt; 0.0 Then 0.0 Else svRawErrorRate</Property>
          <Property Name="SqlType">8</Property>
        </SubRecord>
        <SubRecord>
          <Property Name="Name">svSuccessRate</Property>
          <Property Name="Expression">1.0 - svErrorRate</Property>
          <Property Name="SqlType">8</Property>
        </SubRecord>
        <SubRecord>
          <Property Name="Name">svRawCacheHit</Property>
          <Property Name="Expression">AsDouble(lnk_enriched_telemetry.cache_hit_count) / AsDouble(lnk_enriched_telemetry.requests)</Property>
          <Property Name="SqlType">8</Property>
        </SubRecord>
        <SubRecord>
          <Property Name="Name">svCacheHitRate</Property>
          <Property Name="Expression">If svRawCacheHit &gt; 0.70 Then 0.70 Else If svRawCacheHit &lt; 0.0 Then 0.0 Else svRawCacheHit</Property>
          <Property Name="SqlType">8</Property>
        </SubRecord>
        <SubRecord>
          <Property Name="Name">svTokenCost</Property>
          <Property Name="Expression">(AsDouble(lnk_enriched_telemetry.input_tokens) / 1000000.0) * lnk_enriched_telemetry.input_rate_usd_per_m + (AsDouble(lnk_enriched_telemetry.output_tokens) / 1000000.0) * lnk_enriched_telemetry.output_rate_usd_per_m</Property>
          <Property Name="SqlType">3</Property>
          <Property Name="Precision">18</Property>
          <Property Name="Scale">6</Property>
        </SubRecord>
        <SubRecord>
          <Property Name="Name">svInfraMultiplier</Property>
          <Property Name="Expression">If lnk_enriched_telemetry.provider = "Self-hosted" Then 1.18 Else 1.0</Property>
          <Property Name="SqlType">8</Property>
        </SubRecord>
        <SubRecord>
          <Property Name="Name">svCostUsd</Property>
          <Property Name="Expression">svTokenCost * svInfraMultiplier * (1.0 - 0.35 * svCacheHitRate)</Property>
          <Property Name="SqlType">3</Property>
          <Property Name="Precision">18</Property>
          <Property Name="Scale">4</Property>
        </SubRecord>
        <SubRecord>
          <Property Name="Name">svValuePerSuccess</Property>
          <Property Name="Expression">If lnk_enriched_telemetry.team = "Customer Experience" Then 0.028 Else 0.041</Property>
          <Property Name="SqlType">8</Property>
        </SubRecord>
        <SubRecord>
          <Property Name="Name">svBusinessValueUsd</Property>
          <Property Name="Expression">AsDouble(lnk_enriched_telemetry.requests) * svSuccessRate * svValuePerSuccess * lnk_enriched_telemetry.value_multiplier</Property>
          <Property Name="SqlType">3</Property>
          <Property Name="Precision">18</Property>
          <Property Name="Scale">4</Property>
        </SubRecord>
        <SubRecord>
          <Property Name="Name">svAllocatedBudgetUsd</Property>
          <Property Name="Expression">lnk_enriched_telemetry.daily_budget_usd * lnk_enriched_telemetry.traffic_share * svEnvShare</Property>
          <Property Name="SqlType">3</Property>
          <Property Name="Precision">18</Property>
          <Property Name="Scale">4</Property>
        </SubRecord>
      </Collection>
    </Record>
    <Record Identifier="V0S6P1" Type="TrxInput" Readonly="0">
      <Property Name="Name">lnk_enriched_telemetry</Property>
      <Property Name="Partner">V0S5|V0S5P4</Property>
      <Property Name="LinkType">1</Property>
    </Record>
    <Record Identifier="V0S6P2" Type="TrxOutput" Readonly="0">
      <Property Name="Name">lnk_calculated_metrics</Property>
      <Property Name="Partner">V0S7|V0S7P1</Property>
      <Collection Name="Columns" Type="Column">
        <SubRecord><Property Name="Name">event_date</Property><Property Name="SqlType">9</Property><Property Name="Precision">10</Property><Property Name="Scale">0</Property><Property Name="Nullable">0</Property><Property Name="Derivation">svEventDate</Property></SubRecord>
        <SubRecord><Property Name="Name">team</Property><Property Name="SqlType">12</Property><Property Name="Precision">64</Property><Property Name="Scale">0</Property><Property Name="Nullable">0</Property><Property Name="Derivation">lnk_enriched_telemetry.team</Property></SubRecord>
        <SubRecord><Property Name="Name">product</Property><Property Name="SqlType">12</Property><Property Name="Precision">64</Property><Property Name="Scale">0</Property><Property Name="Nullable">0</Property><Property Name="Derivation">lnk_enriched_telemetry.product</Property></SubRecord>
        <SubRecord><Property Name="Name">provider</Property><Property Name="SqlType">12</Property><Property Name="Precision">64</Property><Property Name="Scale">0</Property><Property Name="Nullable">0</Property><Property Name="Derivation">lnk_enriched_telemetry.provider</Property></SubRecord>
        <SubRecord><Property Name="Name">model</Property><Property Name="SqlType">12</Property><Property Name="Precision">64</Property><Property Name="Scale">0</Property><Property Name="Nullable">0</Property><Property Name="Derivation">lnk_enriched_telemetry.model</Property></SubRecord>
        <SubRecord><Property Name="Name">environment</Property><Property Name="SqlType">12</Property><Property Name="Precision">32</Property><Property Name="Scale">0</Property><Property Name="Nullable">0</Property><Property Name="Derivation">lnk_enriched_telemetry.environment</Property></SubRecord>
        <SubRecord><Property Name="Name">region</Property><Property Name="SqlType">12</Property><Property Name="Precision">32</Property><Property Name="Scale">0</Property><Property Name="Nullable">0</Property><Property Name="Derivation">lnk_enriched_telemetry.region</Property></SubRecord>
        <SubRecord><Property Name="Name">requests</Property><Property Name="SqlType">-5</Property><Property Name="Precision">19</Property><Property Name="Scale">0</Property><Property Name="Nullable">0</Property><Property Name="Derivation">lnk_enriched_telemetry.requests</Property></SubRecord>
        <SubRecord><Property Name="Name">input_tokens</Property><Property Name="SqlType">-5</Property><Property Name="Precision">19</Property><Property Name="Scale">0</Property><Property Name="Nullable">0</Property><Property Name="Derivation">lnk_enriched_telemetry.input_tokens</Property></SubRecord>
        <SubRecord><Property Name="Name">output_tokens</Property><Property Name="SqlType">-5</Property><Property Name="Precision">19</Property><Property Name="Scale">0</Property><Property Name="Nullable">0</Property><Property Name="Derivation">lnk_enriched_telemetry.output_tokens</Property></SubRecord>
        <SubRecord><Property Name="Name">avg_latency_ms</Property><Property Name="SqlType">-5</Property><Property Name="Precision">19</Property><Property Name="Scale">0</Property><Property Name="Nullable">0</Property><Property Name="Derivation">lnk_enriched_telemetry.avg_latency_ms</Property></SubRecord>
        <SubRecord><Property Name="Name">p95_latency_ms</Property><Property Name="SqlType">-5</Property><Property Name="Precision">19</Property><Property Name="Scale">0</Property><Property Name="Nullable">0</Property><Property Name="Derivation">lnk_enriched_telemetry.p95_latency_ms</Property></SubRecord>
        <SubRecord><Property Name="Name">error_rate</Property><Property Name="SqlType">8</Property><Property Name="Precision">15</Property><Property Name="Scale">6</Property><Property Name="Nullable">0</Property><Property Name="Derivation">svErrorRate</Property></SubRecord>
        <SubRecord><Property Name="Name">success_rate</Property><Property Name="SqlType">8</Property><Property Name="Precision">15</Property><Property Name="Scale">6</Property><Property Name="Nullable">0</Property><Property Name="Derivation">svSuccessRate</Property></SubRecord>
        <SubRecord><Property Name="Name">cache_hit_rate</Property><Property Name="SqlType">8</Property><Property Name="Precision">15</Property><Property Name="Scale">6</Property><Property Name="Nullable">0</Property><Property Name="Derivation">svCacheHitRate</Property></SubRecord>
        <SubRecord><Property Name="Name">cost_usd</Property><Property Name="SqlType">3</Property><Property Name="Precision">18</Property><Property Name="Scale">4</Property><Property Name="Nullable">0</Property><Property Name="Derivation">svCostUsd</Property></SubRecord>
        <SubRecord><Property Name="Name">allocated_budget_usd</Property><Property Name="SqlType">3</Property><Property Name="Precision">18</Property><Property Name="Scale">4</Property><Property Name="Nullable">0</Property><Property Name="Derivation">svAllocatedBudgetUsd</Property></SubRecord>
        <SubRecord><Property Name="Name">business_value_usd</Property><Property Name="SqlType">3</Property><Property Name="Precision">18</Property><Property Name="Scale">4</Property><Property Name="Nullable">0</Property><Property Name="Derivation">svBusinessValueUsd</Property></SubRecord>
      </Collection>
    </Record>

    <!-- Stage 7: Aggregator - Daily Consolidation (Hash Partitioning -> 16,200 rows) -->
    <Record Identifier="V0S7" Type="CustomStage" Readonly="0">
      <Property Name="Name">agg_daily_usage</Property>
      <Property Name="StageType">PxAggregator</Property>
      <Property Name="NextID">3</Property>
      <Property Name="InputPins">V0S7P1</Property>
      <Property Name="OutputPins">V0S7P2</Property>
      <Collection Name="Properties" Type="CustomProperty">
        <SubRecord><Property Name="Name">method</Property><Property Name="Value">hash</Property></SubRecord>
        <SubRecord><Property Name="Name">key</Property><Property Name="Value">event_date|team|product|provider|model|environment|region</Property></SubRecord>
        <SubRecord><Property Name="Name">aggregations</Property><Property Name="Value">requests=Sum(requests);input_tokens=Sum(input_tokens);output_tokens=Sum(output_tokens);avg_latency_ms=Mean(avg_latency_ms);p95_latency_ms=Max(p95_latency_ms);error_rate=Mean(error_rate);success_rate=Mean(success_rate);cache_hit_rate=Mean(cache_hit_rate);cost_usd=Sum(cost_usd);allocated_budget_usd=Max(allocated_budget_usd);business_value_usd=Sum(business_value_usd)</Property></SubRecord>
      </Collection>
    </Record>
    <Record Identifier="V0S7P1" Type="CustomInput" Readonly="0">
      <Property Name="Name">lnk_calculated_metrics</Property>
      <Property Name="Partner">V0S6|V0S6P2</Property>
      <Property Name="LinkType">1</Property>
      <Collection Name="MetaBag" Type="MetaProperty">
        <SubRecord><Property Name="Owner">APT</Property><Property Name="Name">PartCol</Property><Property Name="Value">hash</Property></SubRecord>
        <SubRecord><Property Name="Owner">APT</Property><Property Name="Name">HashKey</Property><Property Name="Value">event_date,team,model,environment</Property></SubRecord>
      </Collection>
    </Record>
    <Record Identifier="V0S7P2" Type="CustomOutput" Readonly="0">
      <Property Name="Name">lnk_daily_usage</Property>
      <Property Name="Partner">V0S8|V0S8P1</Property>
      <Collection Name="Columns" Type="Column">
        <SubRecord><Property Name="Name">event_date</Property><Property Name="SqlType">9</Property><Property Name="Precision">10</Property><Property Name="Scale">0</Property><Property Name="Nullable">0</Property><Property Name="KeyPosition">1</Property></SubRecord>
        <SubRecord><Property Name="Name">team</Property><Property Name="SqlType">12</Property><Property Name="Precision">64</Property><Property Name="Scale">0</Property><Property Name="Nullable">0</Property><Property Name="KeyPosition">2</Property></SubRecord>
        <SubRecord><Property Name="Name">product</Property><Property Name="SqlType">12</Property><Property Name="Precision">64</Property><Property Name="Scale">0</Property><Property Name="Nullable">0</Property><Property Name="KeyPosition">3</Property></SubRecord>
        <SubRecord><Property Name="Name">provider</Property><Property Name="SqlType">12</Property><Property Name="Precision">64</Property><Property Name="Scale">0</Property><Property Name="Nullable">0</Property><Property Name="KeyPosition">4</Property></SubRecord>
        <SubRecord><Property Name="Name">model</Property><Property Name="SqlType">12</Property><Property Name="Precision">64</Property><Property Name="Scale">0</Property><Property Name="Nullable">0</Property><Property Name="KeyPosition">5</Property></SubRecord>
        <SubRecord><Property Name="Name">environment</Property><Property Name="SqlType">12</Property><Property Name="Precision">32</Property><Property Name="Scale">0</Property><Property Name="Nullable">0</Property><Property Name="KeyPosition">6</Property></SubRecord>
        <SubRecord><Property Name="Name">region</Property><Property Name="SqlType">12</Property><Property Name="Precision">32</Property><Property Name="Scale">0</Property><Property Name="Nullable">0</Property><Property Name="KeyPosition">7</Property></SubRecord>
        <SubRecord><Property Name="Name">requests</Property><Property Name="SqlType">-5</Property><Property Name="Precision">19</Property><Property Name="Scale">0</Property><Property Name="Nullable">0</Property></SubRecord>
        <SubRecord><Property Name="Name">input_tokens</Property><Property Name="SqlType">-5</Property><Property Name="Precision">19</Property><Property Name="Scale">0</Property><Property Name="Nullable">0</Property></SubRecord>
        <SubRecord><Property Name="Name">output_tokens</Property><Property Name="SqlType">-5</Property><Property Name="Precision">19</Property><Property Name="Scale">0</Property><Property Name="Nullable">0</Property></SubRecord>
        <SubRecord><Property Name="Name">avg_latency_ms</Property><Property Name="SqlType">-5</Property><Property Name="Precision">19</Property><Property Name="Scale">0</Property><Property Name="Nullable">0</Property></SubRecord>
        <SubRecord><Property Name="Name">p95_latency_ms</Property><Property Name="SqlType">-5</Property><Property Name="Precision">19</Property><Property Name="Scale">0</Property><Property Name="Nullable">0</Property></SubRecord>
        <SubRecord><Property Name="Name">error_rate</Property><Property Name="SqlType">8</Property><Property Name="Precision">15</Property><Property Name="Scale">6</Property><Property Name="Nullable">0</Property></SubRecord>
        <SubRecord><Property Name="Name">success_rate</Property><Property Name="SqlType">8</Property><Property Name="Precision">15</Property><Property Name="Scale">6</Property><Property Name="Nullable">0</Property></SubRecord>
        <SubRecord><Property Name="Name">cache_hit_rate</Property><Property Name="SqlType">8</Property><Property Name="Precision">15</Property><Property Name="Scale">6</Property><Property Name="Nullable">0</Property></SubRecord>
        <SubRecord><Property Name="Name">cost_usd</Property><Property Name="SqlType">3</Property><Property Name="Precision">38</Property><Property Name="Scale">9</Property><Property Name="Nullable">0</Property></SubRecord>
        <SubRecord><Property Name="Name">allocated_budget_usd</Property><Property Name="SqlType">3</Property><Property Name="Precision">38</Property><Property Name="Scale">9</Property><Property Name="Nullable">0</Property></SubRecord>
        <SubRecord><Property Name="Name">business_value_usd</Property><Property Name="SqlType">3</Property><Property Name="Precision">38</Property><Property Name="Scale">9</Property><Property Name="Nullable">0</Property></SubRecord>
      </Collection>
    </Record>

    <!-- Stage 8: BigQuery Connector - Target Table ai_economics.ai_usage_daily -->
    <Record Identifier="V0S8" Type="CustomStage" Readonly="0">
      <Property Name="Name">bq_ai_usage_daily</Property>
      <Property Name="StageType">BigQueryConnectorPX</Property>
      <Property Name="NextID">2</Property>
