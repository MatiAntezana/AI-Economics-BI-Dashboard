        <SubRecord><Property Name="Name">p95_latency_ms</Property><Property Name="SqlType">4</Property><Property Name="Precision">10</Property><Property Name="Scale">0</Property><Property Name="Nullable">0</Property></SubRecord>
        <SubRecord><Property Name="Name">error_count</Property><Property Name="SqlType">-5</Property><Property Name="Precision">19</Property><Property Name="Scale">0</Property><Property Name="Nullable">0</Property></SubRecord>
