          <Property Name="Default">rejects/ai_telemetry_rejects.csv</Property>
          <Property Name="ParamType">0</Property>
        </SubRecord>
        <SubRecord>
          <Property Name="Name">pBqProjectId</Property>
          <Property Name="Prompt">BigQuery Project ID</Property>
          <Property Name="Default">YOUR_PROJECT_ID</Property>
          <Property Name="ParamType">0</Property>
        </SubRecord>
        <SubRecord>
          <Property Name="Name">pBqDataset</Property>
          <Property Name="Prompt">BigQuery Dataset</Property>
