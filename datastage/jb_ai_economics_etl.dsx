    <!-- Stage 9: Sequential File - Rejected Telemetry Records -->
    <Record Identifier="V0S9" Type="CustomStage" Readonly="0">
      <Property Name="Name">seq_reject_events</Property>
      <Property Name="StageType">PxSequentialFile</Property>
      <Property Name="NextID">2</Property>
      <Property Name="InputPins">V0S9P1</Property>
      <Collection Name="Properties" Type="CustomProperty">
        <SubRecord><Property Name="Name">file</Property><Property Name="Value">#pRejectFilePath#</Property></SubRecord>
        <SubRecord><Property Name="Name">firstLineColumnNames</Property><Property Name="Value">firstLineColumnNames</Property></SubRecord>
        <SubRecord><Property Name="Name">delimiter</Property><Property Name="Value">,</Property></SubRecord>
        <SubRecord><Property Name="Name">appendMode</Property><Property Name="Value">overwrite</Property></SubRecord>
      </Collection>
    </Record>
    <Record Identifier="V0S9P1" Type="CustomInput" Readonly="0">
      <Property Name="Name">reject_link</Property>
