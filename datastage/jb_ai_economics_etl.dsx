        <SubRecord><Property Name="Name">projectId</Property><Property Name="Value">#pBqProjectId#</Property></SubRecord>
        <SubRecord><Property Name="Name">datasetName</Property><Property Name="Value">#pBqDataset#</Property></SubRecord>
        <SubRecord><Property Name="Name">tableName</Property><Property Name="Value">#pBqTable#</Property></SubRecord>
