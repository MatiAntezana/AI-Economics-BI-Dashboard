    <!-- Stage 4: Filter - Quality Gate -->
    <Record Identifier="V0S4" Type="CustomStage" Readonly="0">
      <Property Name="Name">flt_quality_gate</Property>
      <Property Name="StageType">PxFilter</Property>
      <Property Name="NextID">4</Property>
      <Property Name="InputPins">V0S4P1</Property>
      <Property Name="OutputPins">V0S4P2|V0S4P3</Property>
      <Collection Name="Properties" Type="CustomProperty">
        <SubRecord>
          <Property Name="Name">where</Property>
          <Property Name="Value">event_timestamp IS NOT NULL AND team &lt;&gt; '' AND model &lt;&gt; '' AND (environment = 'production' OR environment = 'staging' OR environment = 'development') AND requests &gt; 0 AND input_tokens &gt;= 0 AND output_tokens &gt;= 0 AND avg_latency_ms &gt;= 0 AND p95_latency_ms &gt;= avg_latency_ms AND error_count &gt;= 0 AND error_count &lt;= requests AND cache_hit_count &gt;= 0 AND cache_hit_count &lt;= requests</Property>
        </SubRecord>
        <SubRecord>
          <Property Name="Name">rejects</Property>
          <Property Name="Value">true</Property>
        </SubRecord>
      </Collection>
    </Record>
