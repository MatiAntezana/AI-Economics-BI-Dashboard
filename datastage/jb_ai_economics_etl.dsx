        <SubRecord><Property Name="Name">output_rate_usd_per_m</Property><Property Name="SqlType">3</Property><Property Name="Precision">10</Property><Property Name="Scale">4</Property><Property Name="Nullable">0</Property></SubRecord>
        <SubRecord><Property Name="Name">traffic_share</Property><Property Name="SqlType">8</Property><Property Name="Precision">15</Property><Property Name="Scale">6</Property><Property Name="Nullable">0</Property></SubRecord>
