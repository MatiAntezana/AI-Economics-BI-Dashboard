        <SubRecord><Property Name="Name">cost_usd</Property><Property Name="SqlType">3</Property><Property Name="Precision">38</Property><Property Name="Scale">9</Property><Property Name="Nullable">0</Property><Property Name="NativeType">NUMERIC</Property></SubRecord>
