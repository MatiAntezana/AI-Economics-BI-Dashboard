      <Property Name="Name">lnk_daily_usage</Property>
      <Property Name="Partner">V0S7|V0S7P2</Property>
      <Property Name="LinkType">1</Property>
      <Collection Name="Columns" Type="Column">
        <SubRecord><Property Name="Name">event_date</Property><Property Name="SqlType">9</Property><Property Name="Precision">10</Property><Property Name="Scale">0</Property><Property Name="Nullable">0</Property><Property Name="NativeType">DATE</Property></SubRecord>
        <SubRecord><Property Name="Name">team</Property><Property Name="SqlType">12</Property><Property Name="Precision">64</Property><Property Name="Scale">0</Property><Property Name="Nullable">0</Property><Property Name="NativeType">STRING</Property></SubRecord>
        <SubRecord><Property Name="Name">product</Property><Property Name="SqlType">12</Property><Property Name="Precision">64</Property><Property Name="Scale">0</Property><Property Name="Nullable">0</Property><Property Name="NativeType">STRING</Property></SubRecord>
        <SubRecord><Property Name="Name">provider</Property><Property Name="SqlType">12</Property><Property Name="Precision">64</Property><Property Name="Scale">0</Property><Property Name="Nullable">0</Property><Property Name="NativeType">STRING</Property></SubRecord>
        <SubRecord><Property Name="Name">model</Property><Property Name="SqlType">12</Property><Property Name="Precision">64</Property><Property Name="Scale">0</Property><Property Name="Nullable">0</Property><Property Name="NativeType">STRING</Property></SubRecord>
        <SubRecord><Property Name="Name">environment</Property><Property Name="SqlType">12</Property><Property Name="Precision">32</Property><Property Name="Scale">0</Property><Property Name="Nullable">0</Property><Property Name="NativeType">STRING</Property></SubRecord>
        <SubRecord><Property Name="Name">region</Property><Property Name="SqlType">12</Property><Property Name="Precision">32</Property><Property Name="Scale">0</Property><Property Name="Nullable">0</Property><Property Name="NativeType">STRING</Property></SubRecord>
        <SubRecord><Property Name="Name">requests</Property><Property Name="SqlType">-5</Property><Property Name="Precision">19</Property><Property Name="Scale">0</Property><Property Name="Nullable">0</Property><Property Name="NativeType">INT64</Property></SubRecord>
        <SubRecord><Property Name="Name">input_tokens</Property><Property Name="SqlType">-5</Property><Property Name="Precision">19</Property><Property Name="Scale">0</Property><Property Name="Nullable">0</Property><Property Name="NativeType">INT64</Property></SubRecord>
        <SubRecord><Property Name="Name">output_tokens</Property><Property Name="SqlType">-5</Property><Property Name="Precision">19</Property><Property Name="Scale">0</Property><Property Name="Nullable">0</Property><Property Name="NativeType">INT64</Property></SubRecord>
        <SubRecord><Property Name="Name">avg_latency_ms</Property><Property Name="SqlType">-5</Property><Property Name="Precision">19</Property><Property Name="Scale">0</Property><Property Name="Nullable">0</Property><Property Name="NativeType">INT64</Property></SubRecord>
        <SubRecord><Property Name="Name">p95_latency_ms</Property><Property Name="SqlType">-5</Property><Property Name="Precision">19</Property><Property Name="Scale">0</Property><Property Name="Nullable">0</Property><Property Name="NativeType">INT64</Property></SubRecord>
        <SubRecord><Property Name="Name">error_rate</Property><Property Name="SqlType">8</Property><Property Name="Precision">15</Property><Property Name="Scale">6</Property><Property Name="Nullable">0</Property><Property Name="NativeType">FLOAT64</Property></SubRecord>
        <SubRecord><Property Name="Name">success_rate</Property><Property Name="SqlType">8</Property><Property Name="Precision">15</Property><Property Name="Scale">6</Property><Property Name="Nullable">0</Property><Property Name="NativeType">FLOAT64</Property></SubRecord>
