    <Record Identifier="ROOT" Type="JobDefn" Readonly="0">
      <Property Name="Name">jb_ai_economics_etl</Property>
      <Property Name="Description">Parallel Job ETL de AI Economics: ingesta de telemetria cruda, control de calidad, lookup de tarifas/presupuestos, calculo de costos y ROI, agregacion diaria (16.200 registros) y carga en BigQuery.</Property>
